# =============================================================================
# VIOGI — Variables de entorno
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA commites .env.local al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# Obtenlos en: https://supabase.com → tu proyecto → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo server-side (admin CRUD, visual search API, scripts CLI). No expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# -----------------------------------------------------------------------------
# Admin panel (/admin/login)
# Contraseña del panel admin. El middleware compara cookie admin_token contra este valor.
# Solo server-side — NO uses NEXT_PUBLIC_.
# Genera uno seguro: openssl rand -hex 32
# -----------------------------------------------------------------------------
ADMIN_SECRET=change-me-to-a-long-random-string

# -----------------------------------------------------------------------------
# Gemini (búsqueda visual + Admin Studio Image)
# API key de Google AI Studio: https://aistudio.google.com/apikey
# Usada en:
#   - app/api/visual-search/route.ts (visión + embeddings)
#   - scripts/generate-embeddings.ts
#   - /admin/studio → app/api/admin/studio/* (visión + Image)
# Studio Image requiere cuota Image en esta key (visión/embeddings no basta).
# Modelos Image: gemini-3.1-flash-image (default), gemini-3-pro-image (modelo).
# No usar gemini-2.5-flash-image (retiro ~2 oct 2026).
# Solo server-side / CLI — NO uses NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=AIza...

# -----------------------------------------------------------------------------
# URL pública del sitio (OAuth, magic links, recovery)
# En Vercel: Settings → Environment Variables → Production (y Preview si aplica).
# Ejemplo: https://viogi.vercel.app o tu dominio custom.
# Si no se define, en deploy se usa VERCEL_URL; en local, headers del request.
# También configura en Supabase → Authentication → URL Configuration:
#   Site URL = esta URL en producción
#   Redirect URLs = https://tu-dominio/** y http://localhost:3000/**
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://tu-app.vercel.app

# -----------------------------------------------------------------------------
# Moneda
# Tipo de cambio MXN/USD para mostrar precios en el locale EN.
# Se usa en lib/formatters.ts: priceInMXN / EXCHANGE_RATE
# -----------------------------------------------------------------------------
NEXT_PUBLIC_USD_MXN_RATE=17.5

# -----------------------------------------------------------------------------
# Pagos — Stripe (Fase 2 activa)
# Dashboard: https://dashboard.stripe.com/apikeys
# En desarrollo usa las keys de TEST (prefijo sk_test_ / pk_test_).
# En producción usa las keys LIVE (prefijo sk_live_ / pk_live_).
# STRIPE_WEBHOOK_SECRET: se genera al crear el webhook en Stripe Dashboard →
#   Developers → Webhooks → Add endpoint → URL: https://tu-dominio/api/webhooks/stripe
#   Eventos a escuchar: payment_intent.succeeded, payment_intent.payment_failed
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Dev local: npm run stripe:listen (Stripe CLI reenvía a /api/webhooks/stripe)

# MercadoPago (diferido — no implementado en Fase 2)
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...

# -----------------------------------------------------------------------------
# Facturación CFDI (Fase futura — dejar vacío por ahora)
# -----------------------------------------------------------------------------
# FACTURAPI_KEY=...

# -----------------------------------------------------------------------------
# Email transaccional (Fase futura — confirmaciones de pedido)
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_...
