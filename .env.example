# =============================================================================
# VIOGI — Variables de entorno
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA commites .env.local al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# Obtenlos en: https://supabase.com → tu proyecto → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo necesario en rutas de servidor (admin, webhooks). No expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# -----------------------------------------------------------------------------
# Moneda
# Tipo de cambio MXN/USD para mostrar precios en el locale EN.
# Se usa en lib/formatters.ts: priceInMXN / EXCHANGE_RATE
# -----------------------------------------------------------------------------
NEXT_PUBLIC_USD_MXN_RATE=17.5

